# Copy to .env.e2e (or export in shell). Never commit real passwords.
# Exam V2 live E2E: scripts/live_exam_v2_e2e.py

E2E_BASE_URL=https://screduc.com
E2E_ADMIN_USER=
E2E_ADMIN_PASS=
E2E_STUDENT_USER=test_exam_student
E2E_STUDENT_PASS=
E2E_CENTER_ID=
E2E_COURSE_ID=
# Comma-separated 24-char hex subject ObjectIds (same course)
E2E_SUBJECT_IDS=
# Optional BSON payloads; otherwise taken from admin JWT `sub`
# E2E_ADMIN_OID=

# Bootstrap DB accounts (run on server with .env loaded):
#   cargo run --bin create_exam_e2e_accounts
